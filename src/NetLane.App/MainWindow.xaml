<Window x:Class="NetLane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetLane"
        Height="720" Width="1180" MinWidth="1000" MinHeight="600"
        Background="{StaticResource Fundo}"
        FontFamily="{StaticResource FaceDeTexto}"
        WindowStartupLocation="CenterScreen">

    <!--
        Fita superior em vez de sidebar (D-010): a sidebar come a largura que as
        raias usam, e a navegacao sera gerada de modulos, nao fixa.
    -->
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fita -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="NetLane" Style="{StaticResource Titulo}" DockPanel.Dock="Left" />
            <TextBlock Text="Início" Style="{StaticResource Rotulo}"
                       Margin="16,8,0,0" DockPanel.Dock="Left" />
            <Button x:Name="BotaoAtualizar" Content="Atualizar" Click="AoAtualizar"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Padding="14,6" Background="{StaticResource FundoElevado}"
                    Foreground="{StaticResource Tinta}"
                    BorderBrush="{StaticResource Borda}" BorderThickness="1" />
        </DockPanel>

        <!-- As raias -->
        <TextBlock Grid.Row="1" Text="LINKS" Style="{StaticResource Rotulo}" Margin="0,0,0,8" />

        <StackPanel Grid.Row="2" Margin="0,0,0,24">
        <ItemsControl ItemsSource="{Binding Links}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,10,0" Padding="0"
                            Background="{StaticResource FundoElevado}"
                            BorderBrush="{StaticResource Borda}" BorderThickness="1"
                            Opacity="{Binding DimWhenNotReady}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- A raia: a faixa de cor E o identificador do link. -->
                            <Rectangle Grid.Column="0"
                                       Fill="{Binding ColorToken, Converter={StaticResource TokenParaCor}}" />

                            <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource Tinta}"
                                           FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StateLabel}"
                                           Style="{StaticResource Rotulo}" Margin="0,2,0,10" />
                                <TextBlock Text="{Binding Address}" Style="{StaticResource Dado}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Gateway}" Style="{StaticResource Dado}"
                                           Foreground="{StaticResource TintaFraca}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Nada some em silencio: o que nao virou coluna e contado aqui. -->
        <TextBlock Text="{Binding HiddenLinksNote}" Style="{StaticResource Rotulo}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Processos -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="PROCESSOS" Style="{StaticResource Rotulo}" DockPanel.Dock="Left" />
                <TextBox x:Name="CaixaFiltro"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         DockPanel.Dock="Right" HorizontalAlignment="Right" Width="260"
                         Padding="8,5" Background="{StaticResource FundoElevado}"
                         Foreground="{StaticResource Tinta}"
                         CaretBrush="{StaticResource Tinta}"
                         BorderBrush="{StaticResource Borda}" BorderThickness="1"
                         FontFamily="{StaticResource FaceDeDados}" />
            </DockPanel>

            <DataGrid Grid.Row="1" x:Name="GradeProcessos"
                      ItemsSource="{Binding Processes}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="#161922"
                      HorizontalGridLinesBrush="{StaticResource Borda}"
                      BorderBrush="{StaticResource Borda}" BorderThickness="1"
                      Foreground="{StaticResource Tinta}"
                      RowHeaderWidth="0" SelectionMode="Single"
                      CanUserAddRows="False" CanUserResizeRows="False">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#20263A" />
                                <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TintaFraca}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Processo" Binding="{Binding DisplayName}" Width="2*" />

                    <DataGridTextColumn Header="Executável" Binding="{Binding ExecutableName}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Dado}">
                                <Setter Property="Foreground" Value="{StaticResource TintaFraca}" />
                                <Setter Property="Margin" Value="10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- A coluna que responde "por onde?" -->
                    <DataGridTemplateColumn Header="Sai por" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Rectangle Width="3" Height="16" VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Fill="{Binding AssignedColorToken, Converter={StaticResource TokenParaCor}}" />
                                    <TextBlock Text="{Binding AssignedLinkName}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Tinta}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Atribuir" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="8,4"
                                          Style="{StaticResource SeletorDeLink}"
                                          ItemContainerStyle="{StaticResource ItemDeSeletor}"
                                          SelectionChanged="AoAtribuir"
                                          Tag="{Binding}"
                                          Loaded="AoCarregarSeletor" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Por quê" Binding="{Binding Explanation}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TintaFraca}" />
                                <Setter Property="Margin" Value="10,0" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Rodape: diz a verdade inteira, inclusive a parte desconfortavel. -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Rotulo}" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding RuleFileLocation}" Style="{StaticResource Rotulo}"
                       DockPanel.Dock="Right" HorizontalAlignment="Right"
                       Foreground="{StaticResource Fumo}"
                       ToolTip="Onde as regras são gravadas" />
        </DockPanel>
    </Grid>
</Window>
