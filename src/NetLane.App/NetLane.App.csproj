<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A interface. Sem regra de negocio: chama o Core. Nao eleva, por decisao:
    quem eleva e o servico, numa fatia posterior.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(NetLaneTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- UseWindowsForms NAO esta ligado, e a fatia do tray vai precisar saber
         por que. D-008 manda usar System.Windows.Forms.NotifyIcon, e ligar
         UseWindowsForms traz os usings implicitos do WinForms junto: ai
         System.Windows.Forms.LinkState colide com NetLane.Abstractions.LinkState
         e System.Windows.Forms.Application com System.Windows.Application, e o
         build quebra em todo arquivo que usa qualquer um dos dois.

         Quando o tray entrar, ligue UseWindowsForms E adicione os aliases:
           <Using Include="System.Windows.Application" Alias="Application" />
           <Using Include="NetLane.Abstractions.LinkState" Alias="LinkState" />
         Medido aqui, nao previsto: custou um build. -->

    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetLane.Abstractions\NetLane.Abstractions.csproj" />
    <ProjectReference Include="..\NetLane.Core\NetLane.Core.csproj" />
    <ProjectReference Include="..\NetLane.Windows\NetLane.Windows.csproj" />
  </ItemGroup>

</Project>
